<doc xmlns="https://hyperview.org/hyperview">
  <screen>
    <styles>
      <style id="container" flex="1" backgroundColor="#ffffff" alignItems="center" justifyContent="center" paddingHorizontal="32" />
      <style id="success-icon" fontSize="64" color="#198754" marginBottom="24" textAlign="center" />
      <style id="success-title" fontSize="24" fontWeight="bold" color="#212529" marginBottom="12" textAlign="center" />
      <style id="success-message" fontSize="16" color="#6c757d" textAlign="center" marginBottom="32" />
      <style id="button" backgroundColor="#0d6efd" paddingVertical="14" paddingHorizontal="24" borderRadius="6" />
      <style id="button-text" color="#ffffff" fontSize="16" fontWeight="600" />
    </styles>

    <body style="container">
      <behavior
        trigger="load"
        action="back"
        delay="1500"
      />

      <text style="success-icon">✓</text>
      <text style="success-title">Contact Created!</text>
      <text style="success-message">{{ contact.first }} {{ contact.last }} has been added to your contacts.</text>

      <view style="button">
        <behavior
          trigger="press"
          action="back"
        />
        <text style="button-text">Back to Contacts</text>
      </view>
    </body>
  </screen>
</doc>
