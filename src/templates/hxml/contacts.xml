<doc xmlns="https://hyperview.org/hyperview">
  <screen>
    <styles>
      <!-- Layout styles -->
      <style id="container" flex="1" backgroundColor="#ffffff" />
      <style id="header-section" paddingTop="16" paddingLeft="16" paddingRight="16" paddingBottom="8" backgroundColor="#f8f9fa" borderBottomWidth="1" borderBottomColor="#dee2e6" />
      <style id="content-section" flex="1" paddingLeft="16" paddingRight="16" paddingTop="16" />

      <!-- Text styles -->
      <style id="header" fontSize="28" fontWeight="bold" color="#212529" />
      <style id="subheader" fontSize="14" color="#6c757d" marginTop="4" />

      <!-- Search input -->
      <style id="search-container" marginTop="16" marginBottom="16" />
      <style id="search-input" borderWidth="1" borderColor="#ced4da" padding="12" borderRadius="6" fontSize="16" backgroundColor="#ffffff" />

      <!-- Contact list item -->
      <style id="contact-item" borderBottomWidth="1" borderBottomColor="#e9ecef" paddingVertical="16" flexDirection="row" alignItems="center" />
      <style id="contact-info" flex="1" />
      <style id="contact-name" fontSize="18" fontWeight="600" color="#212529" />
      <style id="contact-detail" fontSize="14" color="#6c757d" marginTop="4" />
      <style id="chevron" fontSize="20" color="#adb5bd" />

      <!-- Buttons -->
      <style id="add-button-container" paddingTop="16" paddingBottom="24" />
      <style id="add-button" backgroundColor="#0d6efd" paddingVertical="14" paddingHorizontal="20" borderRadius="6" alignItems="center" />
      <style id="add-button-text" color="#ffffff" fontSize="16" fontWeight="600" />

      <!-- Empty state -->
      <style id="empty-state" paddingTop="60" alignItems="center" />
      <style id="empty-text" fontSize="16" color="#6c757d" textAlign="center" />

      <!-- Count -->
      <style id="count-text" fontSize="14" color="#6c757d" marginTop="16" textAlign="center" />
    </styles>

    <body style="container">
      <!-- Header -->
      <view style="header-section">
        <text style="header">Contacts</text>
        <text id="contact-count" style="subheader">
          <behavior
            trigger="load"
            action="replace"
            href="/hv/contacts/count"
          />
          Loading...
        </text>
      </view>

      <view style="content-section">
        <!-- Search -->
        <view style="search-container">
          <text-field
            name="q"
            placeholder="Search contacts..."
            style="search-input"
            value="{{ search }}"
          >
            <behavior
              trigger="change"
              action="replace"
              target="contact-list"
              href="/hv/contacts?q=$q"
              verb="get"
              delay="300"
            />
          </text-field>
        </view>

        <!-- Contact List -->
        <view id="contact-list">
          {% if contacts|length == 0 %}
          <view style="empty-state">
            <text style="empty-text">
              {% if search %}
              No contacts found matching "{{ search }}"
              {% else %}
              No contacts yet. Add your first contact!
              {% endif %}
            </text>
          </view>
          {% else %}
          <list>
            {% for contact in contacts %}
            <item key="{{ contact.id }}" style="contact-item">
              <behavior
                trigger="press"
                action="push"
                href="/hv/contacts/{{ contact.id }}"
              />
              <view style="contact-info">
                <text style="contact-name">{{ contact.first }} {{ contact.last }}</text>
                {% if contact.email %}
                <text style="contact-detail">{{ contact.email }}</text>
                {% endif %}
                {% if contact.phone %}
                <text style="contact-detail">{{ contact.phone }}</text>
                {% endif %}
              </view>
              <text style="chevron">›</text>
            </item>
            {% endfor %}
          </list>
          {% endif %}
        </view>

        <!-- Add Contact Button -->
        <view style="add-button-container">
          <view style="add-button">
            <behavior
              trigger="press"
              action="push"
              href="/hv/contacts/new"
            />
            <text style="add-button-text">Add Contact</text>
          </view>
        </view>
      </view>
    </body>
  </screen>
</doc>
